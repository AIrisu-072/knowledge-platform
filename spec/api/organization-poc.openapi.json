              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkSession"
                }
              }
            }
          },
          "default": {
            "description": "安全なRFC9457エラー。外部状態不明を成功としない",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "安全なRFC9457エラー。外部状態不明を成功としない",
            "content": {
              "application/problem+json": {
