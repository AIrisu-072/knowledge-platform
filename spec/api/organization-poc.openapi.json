  "components": {
    "schemas": {
      "TextValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8192,
            "description": "最大8192 UTF-8 bytes。サーバー側でbyte長も検証する。"
          }
        },
        "required": [
          "text"
        ]
      },
      "WorkSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "principalId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "actingAssignmentId": {
            "type": "string",
            "format": "uuid"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nativeWorkspace": {
                "type": "boolean"
              },
              "agent": {
                "type": "boolean"
              },
              "search": {
                "type": "boolean"
              },
              "fileUpload": {
                "type": "boolean"
              },
              "return": {
                "type": "boolean"
              }
            },
            "required": [
              "nativeWorkspace",
              "agent",
              "search",
              "fileUpload",
              "return"
            ]
          }
        },
        "required": [
          "principalId",
          "displayName",
          "actingAssignmentId",
          "capabilities"
        ]
      },
      "TaskSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "stepLabel": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "active",
              "held",
              "completed"
            ]
          },
          "canClaim": {
            "type": "boolean"
          },
          "canEdit": {
            "type": "boolean"
          },
          "canSubmit": {
            "type": "boolean"
          },
          "handoffSnapshotId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "attemptNumber": {
            "type": "integer",
            "minimum": 1
          },
          "canReturn": {
            "type": "boolean"
          },
          "returnInstructionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "returnTransition": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReturnTransition"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "contextId",
          "attemptId",
          "revision",
          "title",
          "stepLabel",
          "state",
          "canClaim",
          "canEdit",
          "canSubmit",
          "handoffSnapshotId",
          "attemptNumber",
          "canReturn",
          "returnInstructionId",
          "returnTransition"
        ]
      },
      "WorkingArtifact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "schemaId": {
            "const": "organization.text-draft.v1",
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/TextValue"
          },
          "visibility": {
            "const": "work_item_private",
            "type": "string"
          }
        },
        "required": [
          "id",
          "taskId",
          "attemptId",
          "revision",
          "schemaId",
          "value",
          "visibility"
        ]
      },
      "InputResource": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "const": "document"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "documentId",
          "label"
        ]
      },
      "HistoryEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "occurredAt"
        ]
      },
      "TaskDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "stepLabel": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "active",
              "held",
              "completed"
            ]
          },
          "canClaim": {
            "type": "boolean"
          },
          "canEdit": {
            "type": "boolean"
          },
          "canSubmit": {
            "type": "boolean"
          },
          "handoffSnapshotId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "inputResources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputResource"
            },
            "maxItems": 100
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "maxItems": 100
          },
          "workingArtifacts": {
            "type": "array",
            "items": {
