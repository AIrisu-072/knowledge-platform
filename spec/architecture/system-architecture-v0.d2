vars: {
  d2-config: {
    layout-engine: tala
    theme-id: 300
  }
}

direction: down

title: "Knowledge Platform v0 — Document + Search / Discovery"

identity: {
  label: "Identity / Authorization"
  adapter: "Identity Adapter\n安定Principal / Group"
}

document_flow: {
  label: "A. Document Platform（正本）"
  direction: right
  ui: "Document UI"
  api: "Document API\nHuman / Agent 共通"
  core: "Document Platform\nDocument / Version / Folder\nAccessPolicy / ReadState"
  storage: "Document Storage"
  db: "PostgreSQL Metadata"

  ui -> api -> core
  core -> storage
  core -> db
}

sources: {
  label: "B. Discoverable Sources（各Sourceが正本）"
  direction: right
  document: "Document Platform"
  internal: "内部 DB / API"
  crm: "CRM / SFA"
  provider: "MCP / Tool Provider"
  external: "契約外部Source"
  web: "Web / Live Source"
}

discovery_data: {
  label: "C. Federated Discovery / Projection"
  direction: right
  registry: "Global Source Registry\nDiscoverableSource"
  local: "Source-local Directory / Remote Discovery"
  normalize: "Observation / Assertions\nTypedRelationInstance"
  resolve: "Authority / Logical Identity\nDiscovery Lens"
  projections: {
    label: "Derived Projections"
    directory: "Directory"
    structured: "Structured"
    lexical: "Lexical"
    vector: "Vector (optional)"
    temporal: "Temporal"
    access: "Access"
    graph: "Typed HyperEdge Graph"
  }

  registry -> local -> normalize -> resolve
  resolve -> projections.directory
  resolve -> projections.structured
  resolve -> projections.lexical
  resolve -> projections.vector
  resolve -> projections.temporal
  resolve -> projections.access
  resolve -> projections.graph
}

discovery_runtime: {
  label: "D. Search / Discovery Runtime"
  direction: right
  clients: {
    label: "Clients"
    human: "Human Search UI"
    agent: "LLM / Agent"
    batch: "Batch / Service"
  }
  api: "Common Search / Discovery API"
  need: "Need / IntentSignature"
  routing: "Source Routing"
  retrieval: "Adaptive Retrieval\nExact / Structured / Lexical / Vector"
  graph: "HyperGraph Expansion"
  qualify: "Applicability / Contrast\nAuthority / Temporal"
  evidence: "Evidence Sufficiency\nInformationGap"
  result: "SearchResult[] / DiscoveryResult"

  clients.human -> api
  clients.agent -> api
  clients.batch -> api
  api -> need -> routing -> retrieval
  retrieval -> graph -> qualify -> evidence -> result
}

agent_boundary: {
  label: "E. Agent / Execution boundary（Search外）"
  direction: right
  binding: "Session Binding"
  planner: "Task Planner / DAG"
  context: "Context Compiler"
  execution: "Execution Control Plane"
  binding -> planner -> context -> execution
}

ops: {
  label: "F. Observability / Audit"
  direction: right
  otel: "OpenTelemetry / OTLP"
  observability: "Observability Platform"
  audit: "Audit Store"
  evaluation: "Evaluation Artifacts"
  otel -> observability
}

identity.adapter -> document_flow.api
identity.adapter -> discovery_runtime.api

document_flow.core -> sources.document
sources.document -> discovery_data.local
sources.internal -> discovery_data.local
sources.crm -> discovery_data.local
sources.provider -> discovery_data.local
sources.external -> discovery_data.local
sources.web -> discovery_data.local

discovery_data.projections.directory -> discovery_runtime.retrieval
discovery_data.projections.structured -> discovery_runtime.retrieval
discovery_data.projections.lexical -> discovery_runtime.retrieval
discovery_data.projections.vector -> discovery_runtime.retrieval
discovery_data.projections.temporal -> discovery_runtime.qualify
discovery_data.projections.access -> discovery_runtime.qualify
discovery_data.projections.graph -> discovery_runtime.graph

discovery_runtime.result -> agent_boundary.binding: "QualifiedResource / Evidence / Gap"

document_flow.api -> ops.audit: "audit"
discovery_runtime.api -> ops.otel: "telemetry"
discovery_runtime.retrieval -> ops.otel: "telemetry"
discovery_runtime.graph -> ops.otel: "telemetry"
discovery_runtime.evidence -> ops.evaluation: "evaluation trace"
